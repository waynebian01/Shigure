<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap11="http://schemas.microsoft.com/appx/manifest/uap/windows10/11"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 uap11 rescap">
  <Identity
    Name="ArasakaCorporation.Shigure"
    Publisher="CN=Arasaka Corporation"
    Version="1.2.1.28"
    ProcessorArchitecture="neutral" />
  <Properties>
    <DisplayName>Shigure</DisplayName>
    <PublisherDisplayName>Arasaka Corporation</PublisherDisplayName>
    <Description>Shigure WGC identity package</Description>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="zh-CN" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Applications>
    <Application
      Id="Shigure"
      Executable="Shigure.exe"
      uap10:RuntimeBehavior="win32App"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Shigure"
        Description="Shigure"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <uap11:Capability Name="graphicsCaptureProgrammatic" />
    <uap11:Capability Name="graphicsCaptureWithoutBorder" />
  </Capabilities>
</Package>
